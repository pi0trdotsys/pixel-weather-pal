<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal 2.0 COMPACT layout — used only when the host has granted this
     widget instance less than COMPACT_HEIGHT_THRESHOLD_DP (see
     WeatherWidgetProvider), i.e. down at/near minResizeHeight. RemoteViews
     can't shrink a fixed-dp row at runtime (no setViewLayoutHeight pre-API
     31), so rather than fight the default layout's exact-dp row budget this
     is a second, deliberately looser wrap_content layout: it drops the
     sparkline + AQI + sync stack and the status banner outright (see
     buildRemoteViews()) and lets the 4-day grid flex to fill whatever
     vertical room remains, keeping temp/condition/grid/joke — the things
     users actually asked this widget for — as the last things to disappear. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_city_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_header_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="┌─ homebrew weather ─┐"
                    android:textColor="@color/widget_green_dim"
                    android:textSize="8sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="_"
                android:textColor="@color/widget_green"
                android:textSize="8sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_online_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/widget_dot_online" />

            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="10dp">

                <ImageButton
                    android:id="@+id/widget_refresh_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_hitbox"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_refresh" />

                <ProgressBar
                    android:id="@+id/widget_refresh_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/widget_cyan"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- hero: icon + big temp + condition, no sparkline/AQI/sync stack -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_now_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_hero_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:shadowColor="@color/widget_hud_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="6"
                        android:textColor="@color/widget_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_hero_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="1dp"
                        android:layout_marginBottom="1dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:text="C"
                        android:textColor="@color/widget_cyan_dim"
                        android:textSize="7sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_now_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan_dim"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1dp hairline rule -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:background="@color/widget_hud_line" />

        <!-- 4-day grid — flexes to fill whatever room is left. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day0_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_icon0"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_pop0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="7sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_icon1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_pop1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="7sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_icon2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_pop2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="7sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day3_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_icon3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_pop3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- footer: joke only, no separate comment line -->
        <TextView
            android:id="@+id/widget_footer_joke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_amber"
            android:textSize="8sp" />

        <!-- ids kept for RemoteViews compatibility (setters no-op when a
             view id isn't present in the inflated tree) — never shown here. -->
        <TextView
            android:id="@+id/widget_meta_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_footer_comment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

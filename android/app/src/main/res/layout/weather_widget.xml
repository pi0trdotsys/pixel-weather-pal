<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal 2.0 default (true 4x2 = 250x130dp) layout. Row heights below
     START from src/lib/widget-tokens.ts's ROWS/GRID_ROWS (header 12 / gapA 2 /
     hero 28 / gapB 2 [1dp rule nested inside it] / grid 40 [label 9 + icon 13
     + temp 10 + pop 8] / gapC 2 / footer 11 = 97dp), same as the previous
     (99dp/100dp-usable) pass, but were grown FURTHER (header 14 / gapA 2 /
     hero 44 / gapB 2 / grid 44 [label 10 + icon 13 + temp 12 + pop 9] /
     gapC 2 / footer 12 = 120dp, against 120dp usable after padding — see
     minHeight below) after a real-user bug report: the 99dp/100dp budget
     (barely 1dp of slack) only held at the OS accessibility "larger text"
     font_scale=1.0 the previous pass was verified at. A real device with
     font_scale=1.1 (a common, supported accessibility setting — HyperOS and
     other OEM skins allow even more) grows every sp-sized TextView's real
     line height (ascent+descent, still bigger than the nominal sp size even
     with includeFontPadding="false" — CSS line-height:1, the web mockup's
     assumption, has no true Android equivalent) enough to blow straight
     through that 1dp margin, visibly overlapping widget_now_line into the
     hairline rule/grid below it. 120dp of content budget is designed to hold
     up to font_scale ~1.3 (a well-documented stock-Android ceiling) with real
     margin, not just re-pass the one scale it was tested at last time.
     widget_now_line and the 4-day grid's label/temp/pop TextViews additionally
     carry android:autoSizeTextType="uniform" as defense in depth: even a font
     scale bigger than was practically tested here shrinks those specific
     texts gracefully instead of overflowing their now-fixed-height rows.
     minHeight grew 110dp->130dp to match (weather_widget_info.xml); Android
     launchers round granted height UP to whole grid cells anyway, and 130dp
     still reads as "2 cells" on the common 70dp/cell-minus-20dp stock-Launcher3
     formula (120dp for 2 cells) with a little to spare, so this shouldn't look
     wildly oversized vs. the mockup's intent. See docs/widget-spec.md §7 for
     the full writeup of both this deviation and the original one.
     Used whenever the host has NOT granted less than the compact thresholds
     (see WeatherWidgetProvider.COMPACT_*_THRESHOLD_DP) — the smaller/looser
     res/layout/weather_widget_compact.xml is swapped in for that case,
     since RemoteViews can't resize a fixed-dp row at runtime (no
     setViewLayoutHeight pre-API 31). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="5dp">

        <!-- row: header — 14dp (token: 12dp; +2dp for real font-metric headroom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_city_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_header_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="┌─ homebrew weather ─┐"
                    android:textColor="@color/widget_green_dim"
                    android:textSize="9sp" />
            </FrameLayout>

            <!-- Blinking terminal cursor, toggled VISIBLE/GONE roughly once a
                 minute by BlinkAlarm/WeatherWidgetProvider — see BlinkAlarm.kt
                 for why a widget can't do a real smooth blink. -->
            <TextView
                android:id="@+id/widget_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="_"
                android:textColor="@color/widget_green"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_online_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/widget_dot_online" />

            <!-- 12dp (LAYOUT.refreshHitDp) bordered hit-box; the spinner
                 overlays the icon in-place while a refresh is in flight. -->
            <FrameLayout
                android:layout_width="12dp"
                android:layout_height="12dp">

                <ImageButton
                    android:id="@+id/widget_refresh_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_hitbox"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_refresh" />

                <ProgressBar
                    android:id="@+id/widget_refresh_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/widget_cyan"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- row: gapA — 2dp (token: 2dp) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- row: hero — 44dp (token: 28dp; +16dp for real Android font metrics
             at font_scale up to ~1.3, see file header comment) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_now_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="3dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_hero_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:shadowColor="@color/widget_hud_glow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="6"
                            android:textColor="@color/widget_cyan"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_hero_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="1dp"
                            android:layout_marginBottom="2dp"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:text="C"
                            android:textColor="@color/widget_cyan_dim"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Fixed height (rather than wrap_content) is load-bearing, not
                         decorative: autoSizeTextType only has an effect when the view
                         has a bounded height to shrink into — with wrap_content it
                         would just grow with the font instead, which is exactly the
                         overlap bug this exists to prevent. See file header comment. -->
                    <TextView
                        android:id="@+id/widget_now_line"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:autoSizeMaxTextSize="8sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/widget_cyan_dim"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_sparkline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.15"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_pop_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/widget_cyan"
                        android:textSize="8sp" />

                    <!-- maxWidth is load-bearing, not decorative: without it a long AQI
                         category label ("unhealthy (sensitive)", the longest one — see
                         WidgetPreviewDebugActivity's fake data) has unconstrained
                         wrap_content width, which starves the hero row's weighted left
                         cluster (icon/temp/condition) of essentially all its width and
                         hard-clips it (no ellipsis) since Android only elides text once
                         a view is actually measured narrower than its content. -->
                    <TextView
                        android:id="@+id/widget_aqi_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxWidth="64dp"
                        android:singleLine="true"
                        android:textSize="8sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_sync_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/widget_cyan_dim"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- row: gapB — 2dp, the 1dp hairline rule nests inside it (not an
             additional row) so the column budget stays 97dp, not 98dp. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="center_vertical"
                android:background="@color/widget_hud_line" />
        </FrameLayout>

        <!-- row: 4-day grid — 44dp (label 10 + icon 13 + temp 12 + pop 9; token:
             40dp/9+13+10+8 — label/temp/pop each +1-2dp for real font-metric
             headroom at font_scale up to ~1.3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day0_label"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_icon0"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/widget_temp0"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_pop0"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:autoSizeMaxTextSize="8sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="8sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day1_label"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_icon1"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/widget_temp1"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_pop1"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:autoSizeMaxTextSize="8sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="8sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day2_label"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_icon2"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/widget_temp2"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_pop2"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:autoSizeMaxTextSize="8sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="8sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day3_label"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_icon3"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/widget_temp3"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_pop3"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:autoSizeMaxTextSize="8sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- row: gapC — 2dp (token: 2dp) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- current-conditions meta row (feels/hum/wind) — no room for it in
             the true-4x2 row budget (it isn't part of WidgetMock4x2.tsx at
             all); id kept for compatibility but never shown. -->
        <TextView
            android:id="@+id/widget_meta_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- decorative "// sigma.forecast()" comment line — dropped from the
             true-4x2 footer budget (11dp, single line, just the joke) to
             match WidgetMock4x2.tsx exactly; id kept for compatibility but
             never shown (see WeatherWidgetProvider — no longer written to). -->
        <TextView
            android:id="@+id/widget_footer_comment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- row: footer — 12dp (token: 11dp; +1dp for real font-metric headroom) -->
        <TextView
            android:id="@+id/widget_footer_joke"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:autoSizeMaxTextSize="9sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_amber"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Terminal 2.0 status banner (stale / offline / refreshing) — floats
         over the hero row instead of pushing rows down, so it never breaks
         the row budget above. Positioned just below the header, matching
         WidgetMock4x2.tsx's `top: dp(ROWS.header + 2)` in spirit (measured
         from the padded content box: padDp + header + gapA = 5+14+2). -->
    <TextView
        android:id="@+id/widget_status_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="21dp"
        android:background="@drawable/widget_status_banner_bg"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:textSize="8sp"
        android:visibility="gone" />
</FrameLayout>

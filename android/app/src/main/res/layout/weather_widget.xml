<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_header_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="┌─ homebrew weather ─┐"
                android:textColor="@color/widget_green_dim"
                android:textSize="9sp" />

            <!-- Blinking terminal cursor, toggled VISIBLE/GONE roughly once a
                 minute by BlinkAlarm/WeatherWidgetProvider — see BlinkAlarm.kt
                 for why a widget can't do a real smooth blink. -->
            <TextView
                android:id="@+id/widget_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="monospace"
                android:text="_"
                android:textColor="@color/widget_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_online_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/widget_dot_online" />

            <ImageButton
                android:id="@+id/widget_city_btn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@android:color/transparent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_city" />

            <ProgressBar
                android:id="@+id/widget_refresh_spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminateTint="@color/widget_cyan"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/widget_refresh_btn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@android:color/transparent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <!-- Terminal 2.0 status banner (stale / offline / refreshing) — gone by default. -->
        <TextView
            android:id="@+id/widget_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- Terminal 2.0 hero: big current temp + pixel icon + condition/rain + AQI. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_now_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_hero_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_cyan"
                android:shadowColor="@color/widget_hud_glow"
                android:shadowRadius="6"
                android:shadowDx="0"
                android:shadowDy="0" />

            <TextView
                android:id="@+id/widget_now_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_aqi_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1dp hairline between the hero and the 4-day grid (Terminal 2.0 cyan). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_hud_line" />

        <!-- 4-day body grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day0_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/widget_icon0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_pop0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/widget_icon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_pop1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/widget_icon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_pop2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/widget_icon3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_pop3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- current-conditions meta row: feels-like / humidity / wind — extra
             real data now that the taller layout has room for it. -->
        <TextView
            android:id="@+id/widget_meta_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_cyan"
            android:textSize="10sp" />

        <!-- footer -->
        <TextView
            android:id="@+id/widget_footer_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="// sigma.forecast()"
            android:textColor="@color/widget_green_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_footer_joke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_amber"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>

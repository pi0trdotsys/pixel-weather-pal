<?xml version="1.0" encoding="utf-8"?>
<!-- Status banner chip background (mockup: background rgba(4,7,10,0.92),
     1px border in the state color). RemoteViews can't recolor a stroke per
     state without N drawable variants, so the border stays a fixed neutral
     hudLine cyan regardless of state — only the text color (set at runtime
     via setTextColor) actually reflects amber/cyan/crimson state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#EB04070A" />
    <stroke android:width="1px" android:color="@color/widget_hud_line" />
    <corners android:radius="3dp" />
</shape>

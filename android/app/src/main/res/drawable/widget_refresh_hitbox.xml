<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal 2.0 header refresh hit-box: LAYOUT.refreshHitDp (12dp) square,
     1px hudLine border, 3dp corner radius — mirrors WidgetMock4x2.tsx's
     refresh "title" span. Transparent fill so it doesn't add a second bg. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1px" android:color="@color/widget_hud_line" />
    <corners android:radius="3dp" />
</shape>

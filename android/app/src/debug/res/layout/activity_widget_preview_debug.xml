<?xml version="1.0" encoding="utf-8"?>
<!-- DEV-ONLY layout for WidgetPreviewDebugActivity — see that class's doc
     comment. Two FrameLayouts sized to the widget's real guaranteed-minimum
     (250x180dp) and minimum-resize (180x140dp) footprints (matching
     res/xml/weather_widget_info.xml exactly) so the actual RemoteViews tree
     can be inflated into each and screenshotted for a real visual check. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="DEBUG: widget layout preview (dev-only, not shipped)"
            android:textColor="#ff5555"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:text="250dp x 180dp -- guaranteed minimum (minWidth/minHeight)"
            android:textColor="#33ff66"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/preview_default_container"
            android:layout_width="250dp"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:text="180dp x 140dp -- minimum resize (minResizeWidth/Height)"
            android:textColor="#33ff66"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/preview_minresize_container"
            android:layout_width="180dp"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="#222222" />

    </LinearLayout>
</ScrollView>
